{
  "name": "opencode-ufr",
  "version": "0.2.13",
  "description": "Uni Freiburg (UFR) Open WebUI models in opencode — local gateway with key pool, UFR-aware rate limiting, circuit breaker and fallbacks",
  "license": "MIT",
  "type": "module",
  "main": "./src/plugin/index.ts",
  "exports": {
    ".": "./src/plugin/index.ts",
    "./tui": "./dist/tui.js"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.23"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "files": [
    "src",
    "dist",
    "skills",
    "models.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FinleyLaempe/opencode-ufr.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "uni-freiburg",
    "open-webui"
  ],
  "scripts": {
    "build:tui": "bun scripts/build-tui.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build:tui && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "@opentui/core": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "@types/bun": "^1.3.0",
    "babel-preset-solid": "1.9.12",
    "solid-js": "^1.9.15",
    "typescript": "^5.9.0"
  }
}
